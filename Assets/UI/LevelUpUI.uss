/* GameClient/Assets/UI/LevelUpUI.uss */

@import url("Theme.uss");


/* --- Main Panel --- */
.level-up-panel {
    width: 100%;
    height: 100%;
    position: absolute;
    align-items: center;
    justify-content: center;
    background-color: var(--color-background-overlay);
    padding: 20px;
}

.title-label {
    font-size: var(--font-size-title);
    color: var(--color-text-accent);
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
    flex-shrink: 0;
}

/* --- Choices Container --- */
.choices-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    width: 85%;
    max-width: 1400px;
}

/* --- Upgrade Card Styling --- */
.upgrade-choice-card {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 15%;
    min-width: 160px;
    max-width: 220px;
    height: 220px;
    background-color: var(--color-background-panel);
    border-color: var(--color-border-primary);
    border-width: 2px;
    border-radius: 12px;
    padding: 15px;
    margin: 10px;
    align-items: center;
    justify-content: flex-start;
    
    /* MODIFIED: The 'transform' property has been removed from the transition
       as it was the source of the rendering engine error. */
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

/* --- HOVER/ACTIVE STATES (MODIFIED) --- */
/* The problematic 'transform' property has been removed. */
.upgrade-choice-card:hover {
    background-color: var(--color-button-background-hover);
    border-color: var(--color-border-secondary);
}

.upgrade-choice-card:active {
    /* We can use a slightly different color for the active state for feedback. */
    background-color: var(--color-button-background-active);
}


/* --- Card Content --- */
.card-header {
    flex-direction: column;
    align-items: center;
    margin-bottom: 12px;
    width: 100%;
}

.upgrade-icon {
    width: 60px;
    height: 60px;
    margin-bottom: 10px;
    background-color: rgb(30, 30, 30);
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--color-border-primary);
    flex-shrink: 0;
}

.upgrade-title-label {
    font-size: var(--font-size-normal);
    color: var(--color-text-primary);
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.upgrade-description-label {
    font-size: var(--font-size-small);
    color: var(--color-text-off-white);
    white-space: normal;
    -unity-text-align: upper-left;
}
