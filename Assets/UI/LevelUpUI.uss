/* GameClient/Assets/UI/LevelUpUI.uss */
/* --- Main Panel --- */
.level-up-panel {
    width: 100%;
    height: 100%;
    position: absolute;
    align-items: center;
    justify-content: center;
    background-color: var(--color-background-overlay);
    padding-bottom: 30px;
}

.title-label {
    font-size: var(--font-size-large);
    color: var(--color-text-accent);
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.7);
    margin-bottom: 0px;
    flex-shrink: 0;
}

/* --- Choices Container --- */
.choices-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    width: 90%;
    max-width: 500px;
}

/* --- Upgrade Card Styling --- */
.upgrade-choice-card {
    width: 150px;
    height: 140px;
    background-color: var(--color-background-panel);
    border-color: var(--color-border-primary);
    border-width: 2px;
    border-radius: 12px;
    padding: 10px;
    margin: 5px;
    justify-content: flex-start;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

/* --- HOVER/ACTIVE STATES --- */
.upgrade-choice-card:hover {
    background-color: var(--color-button-background-hover);
    border-color: var(--color-border-secondary);
}

.upgrade-choice-card:active {
    background-color: var(--color-button-background-active);
}

.top-container {
    align-items: center;
    width: 100%;
}

.description-container {
    justify-content: center;
    align-items: center;
    height: 40%;
    flex-shrink: 0;
    width: 100%;
}


/* --- Card Content --- */
.upgrade-icon {
    align-self: center;
    width: 50px;
    height: 50px;
    background-color: rgb(30, 30, 30);
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--color-border-primary);
    flex-shrink: 0;
}

.upgrade-title-label {
    font-size: var(--font-size-small);
    color: var(--color-text-primary);
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: middle-center;
}

.upgrade-description-label {
    font-size: var(--font-size-small);
    color: var(--color-text-off-white);
    white-space: normal;
    -unity-text-align: middle-center;
}
