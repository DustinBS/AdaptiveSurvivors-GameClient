/* GameClient/Assets/UI/PlayerHealthBar.uss */

.health-bar-container {
    position: absolute;
    bottom: 20px;
    align-self: center;
    width: 300px;
    height: 30px;
}

.health-bar__background {
    flex-grow: 1;
    background-color: var(--color-health-background);
    border-color: var(--color-health-border);
    border-width: 2px;
    border-radius: 8px;
    padding: 3px;
}

.health-bar__foreground {
    background-color: var(--color-health-foreground);
    border-radius: 5px;
    height: 100%;
    width: 100%;
    transition-property: width;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.health-bar__label {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    font-size: var(--font-size-normal);
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgb(0, 0, 0);
}
