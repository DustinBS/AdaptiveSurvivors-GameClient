/* GameClient/Assets/UI/DialogueUI.uss */

.dialogue-root {
    width: 100%;
    height: 100%;
    position: absolute;
}

.letterbox-bar {
    position: absolute;
    width: 100%;
    height: 12%;
    background-color: black;
}

.top-bar { top: 0; }
.bottom-bar { bottom: 0; }

.bottom-area-container {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 30%;
    flex-direction: row;
    align-items: flex-end;
}

/* Portrait Styling */
.portrait {
    /* CHANGED: Sets the width to 1/4 of the available space. */
    width: 25%;
    /* CHANGED: aspect-ratio automatically sets the height to match the width, creating a perfect square. */
    aspect-ratio: 1;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: var(--color-text-primary);
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.3s;
}

.inactive-speaker {
    -unity-background-image-tint-color: var(--color-button-background-hover);
}

/* Container for the central column (choices + dialogue box) */
.dialogue-and-choices-container {
    width: 50%;
    flex-direction: column-reverse;
    height: 100%;
}

/* Choice Button Styling */
.choice-button-container {
    flex-grow: 1;
    flex-direction: column-reverse;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: flex-end;
    margin-top: 10px;
    overflow: hidden;
    position: relative;
}

.dialogue-choice-button {
    color: var(--color-text-primary);
    background-color: var(--color-dialogue-choice-background);
    border-color: var(--color-dialogue-choice-border);
    font-size: var(--font-size-normal);
    border-width: 2px;
    border-radius: 8px;
    padding: 10px;
    width: 100%;
    margin: 3px 15px 3px 0;
    white-space: normal;
    transition-duration: 0.1s;
}

.dialogue-choice-button:hover {
    background-color: var(--color-dialogue-choice-hover);
    border-color: var(--color-text-primary);
}

/* Dialogue Box Styling */
.dialogue-box {
    width: 100%;
    min-height: 25%;
    flex-shrink: 0;
    background-color: var(--color-dialogue-background);
    border-color: var(--color-dialogue-border);
    border-width: 2px;
    border-radius: 10px;
    padding: 15px 25px;
    position: absolute;
}

.speaker-label {
    position: absolute;
    top: -25px;
    left: 20px;
    padding: 5px 25px;
    background-color: var(--color-dialogue-nameplate);
    color: var(--color-text-accent);
    -unity-font-style: bold;
    font-size: var(--font-size-large);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-width: 2px;
    border-bottom-width: 0;
    border-color: var(--color-dialogue-border);
}

.dialogue-text {
    color: var(--color-text-primary);
    font-size: var(--font-size-normal);
    white-space: normal;
    flex-grow: 1;
}