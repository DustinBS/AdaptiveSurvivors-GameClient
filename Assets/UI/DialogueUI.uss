/* GameClient/Assets/UI/DialogueUI.uss */

/* */
.dialogue-root {
    width: 100%;
    height: 100%;
    position: absolute;
    justify-content: center;
    align-items: center;
}

.letterbox-bar {
    position: absolute;
    width: 100%;
    height: 12%;
    background-color: rgb(0, 0, 0); /* Pure black for cinematic effect  */
}

.top-bar { top: 0;  }
.bottom-bar { bottom: 0;  }

.dialogue-container {
    align-items: flex-end;
    width: 100%;
    height: 100%;
    padding: 0 50px;
}

.portrait {
    aspect-ratio: 1;
    height: 45%;
    max-height: 400px;
    -unity-background-scale-mode: scale-and-crop;
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.3s;
    -unity-background-image-tint-color: var(--color-text-primary);
}

.inactive-speaker {
    -unity-background-image-tint-color: var(--color-button-background-hover);
}

.dialogue-box {
    position: absolute;
    bottom: 14%;
    left: 20%;
    right: 20%;
    height: 28%;
    background-color: var(--color-dialogue-background);
    border-color: var(--color-dialogue-border);
    border-width: 2px;
    border-radius: 10px;
    padding: 15px 25px;
}

.speaker-label {
    position: absolute;
    top: -25px;
    padding: 5px 25px;
    background-color: var(--color-dialogue-nameplate);
    color: var(--color-text-accent);
    -unity-font-style: bold;
    font-size: var(--font-size-large);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-width: 2px;
    border-bottom-width: 0;
    border-color: var(--color-dialogue-border);
}

.speaker-is-player { left: 20px;  }
.speaker-is-npc { right: 20px;  }

.dialogue-text {
    color: var(--color-text-primary);
    font-size: var(--font-size-large);
    white-space: normal;
    flex-grow: 1;
}

.dialogue-choice-button {
    font-size: var(--font-size-large);
    margin: 8px 0;
    padding: 12px;
    width: 80%;
    color: var(--color-text-primary);
    background-color: var(--color-dialogue-choice-background);
    border-color: var(--color-dialogue-choice-border);
    border-width: 2px;
    border-radius: 8px;
    transition-duration: 0.1s;
}

.dialogue-choice-button:hover {
    background-color: var(--color-dialogue-choice-hover);
    border-color: var(--color-text-primary);
}
